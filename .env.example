# Copy to .env in the repo root (gitignored).
POLYGON_API_KEY=
# MASSIVE_API_KEY=   # alias; Polygon.io rebranded to Massive.com

# LLM investment suggestions (POST /api/llm-advice/{symbol})
# Set one or both; auto picks OpenAI first when both are set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# OPENAI_MODEL=gpt-5.2   # example when available on your account

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_MODEL=claude-opus-4-20250514
# LLM_PROVIDER=openai|anthropic|auto

# Selected ticker price poll (seconds). News and Daily TA stay on-demand.
UTOPIA_LIVE_REFRESH_SEC=10
# Stock OHLCV charts, NAV chart, and portfolio performance (seconds).
UTOPIA_CHART_REFRESH_SEC=30

# Auto paper strategies: how often to try a step while ./start.sh is running (seconds).
UTOPIA_STRATEGY_INTERVAL_SEC=3600
